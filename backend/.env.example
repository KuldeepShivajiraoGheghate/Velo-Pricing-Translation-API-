# Velo Backend — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=local                        # local | staging | production
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440     # 24 hours

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://velo:velo_dev_password@localhost:5432/velo_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── FX Rate Provider ──────────────────────────────────────────────────────────
FX_PROVIDER_BASE_URL=https://api.frankfurter.app
FX_REFRESH_INTERVAL_MINUTES=60

# ── Stripe ────────────────────────────────────────────────────────────────────
# Store the test key here. Rotate this key after development.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# ── Chargebee (stub — fill in when credentials are available) ─────────────────
# CHARGEBEE_SITE=your-site.chargebee.com
# CHARGEBEE_API_KEY=

# ── Recurly (stub — fill in when credentials are available) ───────────────────
# RECURLY_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
